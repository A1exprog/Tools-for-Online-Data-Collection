    },
    {
      "parameters": {
        "jsCode": "// Нормализация данных под формат CSV\nreturn $input.all().map(item => {\n  const data = item.json;\n  \n  // Цена в WooCommerce хранится в копейках (например, 6900), делим на 100\n  let price = '';\n  if (data.prices && data.prices.price) {\n    price = (parseFloat(data.prices.price) / 100).toFixed(2);\n  } else if (data.sale_price || data.regular_price) {\n    // Fallback для XHR источника\n    price = String(data.sale_price || data.regular_price).replace(/[^0-9.]/g, '');\n  }\n\n  // Извлечение первой картинки\n  let image = '';\n  if (data.images && Array.isArray(data.images)) {\n    image = data.images[0].src || '';\n  } else if (typeof data.images === 'string') {\n    image = data.images.split(',')[0].trim();\n  }\n\n  return {\n    json: {\n      name: (data.name || '').trim(),\n      sku: data.sku || '',\n      price: price,\n      link: data.permalink || `https://www.scrapingcourse.com/ecommerce/product/${(data.name || '').toLowerCase().replace(/\\s+/g, '-')}`,\n      image: image,\n      source: data.prices ? 'woocommerce_api' : 'xhr_api'\n    }\n  };\n});"
      },
