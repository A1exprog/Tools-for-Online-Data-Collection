    {
      "parameters": {
        "jsCode": "// Нормализация товаров DummyJSON: аналог clean.py (без персональных данных)\nconst MAP = { 'mens-shirts':'tops', 'tops':'tops', 'womens-bags':'bags', 'mens-watches':'watches',\n  'womens-watches':'watches', 'sports-accessories':'fitness', 'mens-shoes':'shoes', 'womens-shoes':'shoes',\n  'womens-dresses':'dresses' };\nconst now = new Date().toISOString();\nreturn $input.all().map(({ json: p }) => {\n  const disc = p.discountPercentage ?? 0;\n  return { json: {\n    business_key: `dummyjson:${p.id}`,\n    source: 'dummyjson.com',\n    source_id: String(p.id),\n    title: p.title,\n    category_raw: p.category,\n    product_group: MAP[p.category] || 'other',\n    price_usd: p.price,\n    regular_price_usd: disc < 100 ? +(p.price / (1 - disc / 100)).toFixed(2) : p.price,\n    discount_pct: disc,\n    rating: p.rating,\n    in_stock: (p.stock ?? 0) > 0,\n    stock_qty: p.stock ?? null,\n    sku: p.sku || null,\n    url: `https://dummyjson.com/products/${p.id}`,\n    collected_at: now,\n    collected_by: 'n8n',\n  }};\n});\n"
      },
      "id": "83e1c16a-8ae8-46e4-be60-2f7365625ce2",
      "name": "Нормализация API (без ПДн)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        560
      ],
      "notes": "Группа по категории DummyJSON, цена до скидки, наличие по stock. Отзывы с ПДн сюда не попадают.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// Отзывы DummyJSON: по строке на отзыв, имя и e-mail автора НЕ сохраняем\nconst out = [];\nfor (const { json: p } of $input.all()) {\n  (p.reviews || []).forEach((r, i) => out.push({ json: {\n    review_key: `dummyjson:${p.id}:r${i}`,\n    product_key: `dummyjson:${p.id}`,\n    rating: r.rating,\n    comment: r.comment,\n    review_date: r.date,\n  }}));\n}\nreturn out;\n"
      },
      "id": "291034b9-5ffa-4059-92c5-718abdbbf8d5",
      "name": "Отзывы API (без ПДн)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        760
      ],
      "notes": "reviewerName и reviewerEmail не копируются.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "8c33b16e-d797-4f2a-b899-74f2fc9b90a6",
      "name": "Все товары",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        2020,
        420
      ]
