    {
      "parameters": {
        "jsCode": "// Проверка качества: упрощённый аналог quality.py (6 метрик, светофор)\nconst rows = $input.all().map(i => i.json);\nlet reviews = 0;\ntry { reviews = $('Отзывы API (без ПДн)').all().length; } catch (e) { reviews = 0; }\nconst n = rows.length;\nconst bySrc = s => rows.filter(r => r.source === s).length;\nconst keys = rows.map(r => r.business_key);\nconst dupPct = n ? (1 - new Set(keys).size / n) * 100 : 0;\nconst noPricePct = n ? rows.filter(r => !(r.price_usd > 0)).length / n * 100 : 100;\nconst html = rows.filter(r => r.source === 'scrapingcourse.com');\nconst unmappedPct = html.length ? html.filter(r => r.product_group === 'other').length / html.length * 100 : 100;\nconst groupsHtml = new Set(html.map(r => r.product_group).filter(g => g !== 'other'));\nconst overlap = [...new Set(rows.filter(r => r.source === 'dummyjson.com').map(r => r.product_group))]\n  .filter(g => groupsHtml.has(g)).length;\n// [название, значение, warn, critical, направление]\nconst M = [\n  ['products_count',          n,                                       350, 300, 'min'],\n  ['min_products_per_source', Math.min(bySrc('scrapingcourse.com'), bySrc('dummyjson.com')), 150, 100, 'min'],\n  ['reviews_count',           reviews,                                 400, 300, 'min'],\n  ['duplicate_key_pct',       +dupPct.toFixed(2),                      0.5, 2,   'max'],\n  ['missing_price_pct',       +noPricePct.toFixed(2),                  1,   5,   'max'],\n  ['html_unmapped_group_pct', +unmappedPct.toFixed(2),                 15,  40,  'max'],\n  ['group_overlap_count',     overlap,                                 3,   1,   'min'],\n];\nconst level = ([, v, w, c, d]) => d === 'min' ? (v < c ? 'CRITICAL' : v < w ? 'WARN' : 'OK')\n                                             : (v > c ? 'CRITICAL' : v > w ? 'WARN' : 'OK');\nconst metrics = M.map(m => ({ name: m[0], value: m[1], warn: m[2], critical: m[3], level: level(m) }));\nconst status = metrics.some(m => m.level === 'CRITICAL') ? 'RED' : metrics.some(m => m.level === 'WARN') ? 'YELLOW' : 'GREEN';\nconst lines = metrics.map(m => `${m.level === 'OK' ? '✅' : m.level === 'WARN' ? '⚠️' : '⛔'} ${m.name}: ${m.value}`);\nreturn [{ json: {\n  status, metrics,\n  products: n, html_products: bySrc('scrapingcourse.com'), api_products: bySrc('dummyjson.com'), reviews,\n  message: `n8n-сбор: ${status}\\nТоваров ${n} (HTML ${bySrc('scrapingcourse.com')}, API ${bySrc('dummyjson.com')}), отзывов ${reviews}\\n` + lines.join('\\n'),\n}}];\n"
      },
      "id": "68571d2d-32dd-4225-9623-5a05fda83ef3",
      "name": "Проверка качества",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        420
      ],
      "notes": "7 метрик с порогами WARN/CRITICAL и светофор GREEN/YELLOW/RED (упрощённый quality.py).",
      "notesInFlow": true
    },
