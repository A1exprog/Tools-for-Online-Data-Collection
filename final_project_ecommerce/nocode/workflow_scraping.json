      "id": "7f5849eb-9172-4ea7-8aff-f69a14f44837",
      "name": "API: товары (limit/skip)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        620
      ],
      "retryOnFail": true,
      "maxTries": 3,
