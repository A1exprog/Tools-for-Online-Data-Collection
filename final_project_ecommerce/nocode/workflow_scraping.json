    {
      "parameters": {
        "jsCode": "// Нормализация HTML-товаров: аналог clean.py для scrapingcourse.com\nconst RULES = [  // порядок важен: первое совпадение побеждает (как config.yaml → linkage)\n  ['bags',      ['bag','bags','backpack','duffle','tote','messenger']],\n  ['watches',   ['watch','watches']],\n  ['fitness',   ['fitness','equipment','yoga','strap','band','ball','bottle','rope','kettlebell','dumbbell','roller','sprite','gear']],\n  ['outerwear', ['jacket','jackets','coat','windbreaker','shell','parka']],\n  ['bottoms',   ['pant','pants','short','shorts','legging','leggings','tights','capri','bottoms']],\n  ['tops',      ['hoodie','hoodies','sweatshirt','sweatshirts','tee','tees','shirt','tank','tanks','bra','bras','top','tops','pullover','sweater','jersey']],\n  ['shoes',     ['shoe','shoes','sneaker','sneakers','boot','boots']],\n];\nconst match = (text) => {\n  const blob = ' ' + String(text || '').toLowerCase().replace(/[-&|,]/g, ' ') + ' ';\n  for (const [group, words] of RULES)\n    if (words.some(w => new RegExp(`\\\\b${w}\\\\b`).test(blob))) return group;\n  return null;\n};\nconst nums = (t) => (String(t || '').match(/\\d[\\d,]*(?:\\.\\d+)?/g) || []).map(s => parseFloat(s.replace(/,/g, '')));\nconst now = new Date().toISOString();\nconst out = [];\nconst seen = new Set();\nfor (const item of $input.all()) {\n  const j = item.json;\n  const url = j.url || '';\n  const slug = (url.split('/product/')[1] || '').replace(/\\/$/, '');\n  if (!slug || seen.has(slug)) continue;           // дубль бизнес-ключа -> пропуск\n  seen.add(slug);\n  // цена: обычная, диапазон «$45 – $69» или распродажа (Original price … Current price …)\n  const p = nums(j.price_text);\n  let price = null, regular = null;\n  if (/current price/i.test(j.price_text || '') && p.length >= 2) { regular = p[0]; price = p[p.length - 1]; }\n  else if (p.length) { price = Math.min(...p); regular = price; }\n  // наличие: у вариативных товаров — по вариациям (у самого товара WooCommerce пишет outofstock)\n  let inStock = !/out of stock/i.test(j.stock_text || '');\n  let stockQty = null;\n  if (j.variations && j.variations !== 'false') {\n    try {\n      const vars = JSON.parse(j.variations);\n      inStock = vars.some(v => v.is_in_stock);\n      const q = vars.map(v => (String(v.availability_html || '').match(/(\\d+)\\s+in stock/i) || [])[1]).filter(Boolean).map(Number);\n      stockQty = q.length ? q.reduce((a, b) => a + b, 0) : null;\n    } catch (e) { /* битый JSON — оставляем текстовый признак */ }\n  }\n  const cats = Array.isArray(j.categories) ? j.categories : (j.categories ? [j.categories] : []);\n  out.push({ json: {\n    business_key: `scrapingcourse:${slug}`,\n    source: 'scrapingcourse.com',\n    source_id: slug,\n    title: String(j.name || '').trim(),\n    category_raw: cats.join(' | '),\n    product_group: match(cats.join(' ')) || match(j.name) || 'other',\n    price_usd: price,\n    regular_price_usd: regular,\n    discount_pct: price && regular && regular > price ? +((1 - price / regular) * 100).toFixed(2) : 0,\n    rating: null,\n    in_stock: inStock,\n    stock_qty: stockQty,\n    sku: j.sku_detail || j.sku || null,\n    url,\n    collected_at: now,\n    collected_by: 'n8n',\n  }});\n}\nreturn out;\n"
      },
      "id": "f383334f-ac04-480f-a74f-2349ec29b11b",
      "name": "Нормализация HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        220
      ],
      "notes": "Цена → число, slug → бизнес-ключ, группа по правилам, наличие по вариациям, дубли отбрасываются.",
      "notesInFlow": true
    },
