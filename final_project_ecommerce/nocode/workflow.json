    {
      "parameters": {
        "command": "cd /d \"C:\\Users\\A1ex5\\Desktop\\CodeFlow\\web-scrapers\\total_project\\final_project_ecommerce\" && python -m src.n8n_entry"
      },
      "id": "83d7c3d0-90a7-4be2-aa1b-065313d47ed2",
      "name": "Запуск пайплайна (Python)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        260,
        100
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "notes": "src/n8n_entry.py всегда завершается с кодом 0 и печатает одну JSON-строку. На Linux/macOS: cd /path/to/final_project_ecommerce && python3 -m src.n8n_entry"
    },
    {
      "parameters": {
        "jsCode": "// stdout узла Execute Command -> объект сводки\nconst lines = ($json.stdout || '').trim().split('\\n');\nlet s;\ntry { s = JSON.parse(lines[lines.length - 1]); }\ncatch (e) { s = { exit_code: 2, critical: true, error: 'не удалось разобрать вывод: ' + ($json.stderr || e.message) }; }\nconst alerts = (s.alerts || []).map(a => `• ${a.severity.toUpperCase()} ${a.name}: ${a.message}`).join('\\n') || '• нет';\nconst icon = s.critical ? '🔴' : (s.quality_status === 'YELLOW' ? '🟡' : '🟢');\ns.message = `${icon} Пайплайн e-commerce, прогон ${s.run_id || '—'}\\n` +\n  `exit_code=${s.exit_code}, качество=${s.quality_status}, ${s.duration_sec} c\\n` +\n  `Источники: ${JSON.stringify(s.source_status)}\\n` +\n  `Запросов ${s.requests_total}, 304: ${s.not_modified_304}, ошибок ${((s.error_rate||0)*100).toFixed(1)}%, p95 ${s.latency_p95_ms} мс\\n` +\n  `Товаров ${s.products_clean}, отзывов ${s.reviews_clean}; загрузка: ${JSON.stringify(s.load)}\\n` +\n  `Оповещения:\\n${alerts}` + (s.error ? `\\nОшибка: ${s.error}` : '');\nreturn [{ json: s }];"
      },
      "id": "65ed3213-1e0e-45f3-973d-203d6aebabd9",
      "name": "Разбор отчёта",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
